{
  "name": "blink-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "preview:ui": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:live": "vitest run --config vitest.benchmark.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "1.94.0",
    "@phosphor-icons/react": "2.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wxt": "0.21.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/chrome": "0.2.5",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "10.0.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.0"
  }
}
